Asset Growth % = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[asset_growth_pct]), KEEPFILTERS(dim_year[sort_order] = Period))

Company Count = COUNTROWS(dim_company)

Sector Count = DISTINCTCOUNT(dim_company[sector])

Scored Companies = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(COUNT(vw_metrics[overall_score]), KEEPFILTERS(dim_year[sort_order] = Period))

Complete Statements = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(CALCULATE(COUNTROWS(vw_metrics),vw_metrics[statement_coverage_pct]=100), KEEPFILTERS(dim_year[sort_order] = Period))

Median Health Score = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(MEDIAN(vw_metrics[overall_score]), KEEPFILTERS(dim_year[sort_order] = Period))

Net Margin % = DIVIDE([PAT (INR Cr)], [Revenue (INR Cr)]) * 100

Operating Margin % = DIVIDE([Operating Profit (INR Cr)], [Revenue (INR Cr)]) * 100

EBIT Margin % = DIVIDE([EBIT (INR Cr)], [Revenue (INR Cr)]) * 100

EPS (INR) = IF(HASONEVALUE(dim_company[symbol]), VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(MAX(vw_metrics[eps]), KEEPFILTERS(dim_year[sort_order] = Period)))

Health Rank = IF(NOT ISBLANK([Health Score]), RANKX(FILTER(ALLSELECTED(dim_company),NOT ISBLANK([Health Score])),[Health Score],,DESC,Skip))

Universe Median = CALCULATE([Median Health Score],REMOVEFILTERS(dim_company),REMOVEFILTERS(dim_sector))

Sector Median = VAR Sector = SELECTEDVALUE(dim_company[sector]) RETURN CALCULATE([Median Health Score],REMOVEFILTERS(dim_company),dim_company[sector]=Sector)

Percentile = VAR N=COUNTROWS(FILTER(ALLSELECTED(dim_company),NOT ISBLANK([Health Score]))) RETURN IF(NOT ISBLANK([Health Score]),IF(N=1,100,DIVIDE(N-[Health Rank],N-1)*100))

Screening Note = "Historical quantitative screening; not investment advice. Blank values indicate unavailable inputs."