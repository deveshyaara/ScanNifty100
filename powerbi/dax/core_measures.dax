Revenue (INR Cr) = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[sales]), KEEPFILTERS(dim_year[sort_order] = Period))

