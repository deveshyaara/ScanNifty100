table vw_metrics
	column id
		dataType: int64
		sourceColumn: id
		summarizeBy: none
		isHidden

	column symbol
		dataType: string
		sourceColumn: symbol
		summarizeBy: none

	column year_id
		dataType: int64
		sourceColumn: year_id
		summarizeBy: none
		isHidden

	column overall_score
		dataType: double
		sourceColumn: overall_score
		summarizeBy: none

	column coverage_pct
		dataType: double
		sourceColumn: coverage_pct
		summarizeBy: none

	column sales
		dataType: double
		sourceColumn: sales
		summarizeBy: none

	column net_profit
		dataType: double
		sourceColumn: net_profit
		summarizeBy: none

	column eps
		dataType: double
		sourceColumn: eps
		summarizeBy: none

	column operating_profit
		dataType: double
		sourceColumn: operating_profit
		summarizeBy: none

	column ebit
		dataType: double
		sourceColumn: ebit
		summarizeBy: none

	column ebitda
		dataType: double
		sourceColumn: ebitda
		summarizeBy: none

	column revenue_growth_pct
		dataType: double
		sourceColumn: revenue_growth_pct
		summarizeBy: none

	column profit_growth_pct
		dataType: double
		sourceColumn: profit_growth_pct
		summarizeBy: none

	column eps_growth_pct
		dataType: double
		sourceColumn: eps_growth_pct
		summarizeBy: none

	column revenue_cagr_3y_pct
		dataType: double
		sourceColumn: revenue_cagr_3y_pct
		summarizeBy: none

	column revenue_cagr_5y_pct
		dataType: double
		sourceColumn: revenue_cagr_5y_pct
		summarizeBy: none

	column profit_cagr_3y_pct
		dataType: double
		sourceColumn: profit_cagr_3y_pct
		summarizeBy: none

	column profit_cagr_5y_pct
		dataType: double
		sourceColumn: profit_cagr_5y_pct
		summarizeBy: none

	column net_profit_margin_pct
		dataType: double
		sourceColumn: net_profit_margin_pct
		summarizeBy: none

	column operating_margin_pct
		dataType: double
		sourceColumn: operating_margin_pct
		summarizeBy: none

	column ebit_margin_pct
		dataType: double
		sourceColumn: ebit_margin_pct
		summarizeBy: none

	column ebitda_margin_pct
		dataType: double
		sourceColumn: ebitda_margin_pct
		summarizeBy: none

	column roe_pct
		dataType: double
		sourceColumn: roe_pct
		summarizeBy: none

	column roa_pct
		dataType: double
		sourceColumn: roa_pct
		summarizeBy: none

	column roce_pct
		dataType: double
		sourceColumn: roce_pct
		summarizeBy: none

	column debt_to_equity
		dataType: double
		sourceColumn: debt_to_equity
		summarizeBy: none

	column equity_ratio
		dataType: double
		sourceColumn: equity_ratio
		summarizeBy: none

	column asset_turnover
		dataType: double
		sourceColumn: asset_turnover
		summarizeBy: none

	column cash_conversion_ratio
		dataType: double
		sourceColumn: cash_conversion_ratio
		summarizeBy: none

	column cfo_margin_pct
		dataType: double
		sourceColumn: cfo_margin_pct
		summarizeBy: none

	column operating_activity
		dataType: double
		sourceColumn: operating_activity
		summarizeBy: none

	column investing_activity
		dataType: double
		sourceColumn: investing_activity
		summarizeBy: none

	column financing_activity
		dataType: double
		sourceColumn: financing_activity
		summarizeBy: none

	column total_assets
		dataType: double
		sourceColumn: total_assets
		summarizeBy: none

	column total_liabilities
		dataType: double
		sourceColumn: total_liabilities
		summarizeBy: none

	column shareholders_equity
		dataType: double
		sourceColumn: shareholders_equity
		summarizeBy: none

	column borrowings
		dataType: double
		sourceColumn: borrowings
		summarizeBy: none

	column equity_growth_pct
		dataType: double
		sourceColumn: equity_growth_pct
		summarizeBy: none

	column asset_growth_pct
		dataType: double
		sourceColumn: asset_growth_pct
		summarizeBy: none

	column statement_coverage_pct
		dataType: double
		sourceColumn: statement_coverage_pct
		summarizeBy: none

	column free_cash_flow
		dataType: double
		sourceColumn: free_cash_flow
		summarizeBy: none

	column capex
		dataType: double
		sourceColumn: capex
		summarizeBy: none

	column cash
		dataType: double
		sourceColumn: cash
		summarizeBy: none

	column net_debt
		dataType: double
		sourceColumn: net_debt
		summarizeBy: none

	column current_ratio
		dataType: double
		sourceColumn: current_ratio
		summarizeBy: none

	column quick_ratio
		dataType: double
		sourceColumn: quick_ratio
		summarizeBy: none

	column profit_positive_fraction
		dataType: double
		sourceColumn: profit_positive_fraction
		summarizeBy: none

	column cfo_positive_fraction
		dataType: double
		sourceColumn: cfo_positive_fraction
		summarizeBy: none

	column profitability_score
		dataType: double
		sourceColumn: profitability_score
		summarizeBy: none

	column growth_score
		dataType: double
		sourceColumn: growth_score
		summarizeBy: none

	column balance_sheet_score
		dataType: double
		sourceColumn: balance_sheet_score
		summarizeBy: none

	column cash_flow_score
		dataType: double
		sourceColumn: cash_flow_score
		summarizeBy: none

	column efficiency_score
		dataType: double
		sourceColumn: efficiency_score
		summarizeBy: none

	column consistency_score
		dataType: double
		sourceColumn: consistency_score
		summarizeBy: none

	column status
		dataType: string
		sourceColumn: status
		summarizeBy: none

	column health_label
		dataType: string
		sourceColumn: health_label
		summarizeBy: none

	column model_version
		dataType: string
		sourceColumn: model_version
		summarizeBy: none
		isHidden

	column identity_status
		dataType: string
		sourceColumn: identity_status
		summarizeBy: none

	column score_explanation
		dataType: string
		sourceColumn: score_explanation
		summarizeBy: none

	measure 'Revenue (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[sales]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'PAT (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[net_profit]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Operating Profit (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[operating_profit]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'EBIT (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[ebit]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'EBITDA (unavailable)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[ebitda]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Assets (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[total_assets]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Liabilities (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[total_liabilities]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Equity (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[shareholders_equity]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Debt (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[borrowings]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'CFO (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[operating_activity]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Investing Cash (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[investing_activity]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Financing Cash (INR Cr)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[financing_activity]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'FCF (unavailable)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[free_cash_flow]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Capex (unavailable)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[capex]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Cash (unavailable)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[cash]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Net Debt (unavailable)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(SUM(vw_metrics[net_debt]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: #,0.0

	measure 'Health Score' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[overall_score]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Coverage %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[coverage_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'Revenue Growth %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[revenue_growth_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'Profit Growth %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[profit_growth_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'EPS Growth %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[eps_growth_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'Revenue CAGR 3Y %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[revenue_cagr_3y_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'Revenue CAGR 5Y %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[revenue_cagr_5y_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'ROE %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[roe_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'ROA %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[roa_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'ROCE % (unavailable)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[roce_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'Debt to Equity' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[debt_to_equity]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'CFO to PAT' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[cash_conversion_ratio]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Current Ratio (unavailable)' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[current_ratio]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Asset Turnover' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[asset_turnover]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Profitability Score' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[profitability_score]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Growth Score' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[growth_score]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Balance Sheet Score' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[balance_sheet_score]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Cash Flow Score' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[cash_flow_score]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Efficiency Score' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[efficiency_score]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Consistency Score' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[consistency_score]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Cash Consistency' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[cfo_positive_fraction]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Growth Consistency' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[profit_positive_fraction]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Equity Growth %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[equity_growth_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'Asset Growth %' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(AVERAGE(vw_metrics[asset_growth_pct]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.0"%"

	measure 'Company Count' = COUNTROWS(dim_company)
		formatString: 0

	measure 'Sector Count' = DISTINCTCOUNT(dim_company[sector])
		formatString: 0

	measure 'Scored Companies' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(COUNT(vw_metrics[overall_score]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0

	measure 'Complete Statements' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(CALCULATE(COUNTROWS(vw_metrics),vw_metrics[statement_coverage_pct]=100), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0

	measure 'Median Health Score' = VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(MEDIAN(vw_metrics[overall_score]), KEEPFILTERS(dim_year[sort_order] = Period))
		formatString: 0.00

	measure 'Net Margin %' = DIVIDE([PAT (INR Cr)], [Revenue (INR Cr)]) * 100
		formatString: 0.0"%"

	measure 'Operating Margin %' = DIVIDE([Operating Profit (INR Cr)], [Revenue (INR Cr)]) * 100
		formatString: 0.0"%"

	measure 'EBIT Margin %' = DIVIDE([EBIT (INR Cr)], [Revenue (INR Cr)]) * 100
		formatString: 0.0"%"

	measure 'EPS (INR)' = IF(HASONEVALUE(dim_company[symbol]), VAR Period = MAXX(FILTER(dim_year, NOT(dim_year[is_ttm]) && NOT(dim_year[is_half_year])), dim_year[sort_order]) RETURN CALCULATE(MAX(vw_metrics[eps]), KEEPFILTERS(dim_year[sort_order] = Period)))
		formatString: 0.00

	measure 'Health Rank' = IF(NOT ISBLANK([Health Score]), RANKX(FILTER(ALLSELECTED(dim_company),NOT ISBLANK([Health Score])),[Health Score],,DESC,Skip))
		formatString: 0

	measure 'Universe Median' = CALCULATE([Median Health Score],REMOVEFILTERS(dim_company),REMOVEFILTERS(dim_sector))
		formatString: 0.00

	measure 'Sector Median' = VAR Sector = SELECTEDVALUE(dim_company[sector]) RETURN CALCULATE([Median Health Score],REMOVEFILTERS(dim_company),dim_company[sector]=Sector)
		formatString: 0.00

	measure 'Percentile' = VAR N=COUNTROWS(FILTER(ALLSELECTED(dim_company),NOT ISBLANK([Health Score]))) RETURN IF(NOT ISBLANK([Health Score]),IF(N=1,100,DIVIDE(N-[Health Rank],N-1)*100))
		formatString: 0.0"%"

	measure 'Screening Note' = "Historical quantitative screening; not investment advice. Blank values indicate unavailable inputs."
		displayFolder: Screening

	partition vw_metrics = m
		mode: import
		source =
			let
			    Source = PostgreSQL.Database(WarehouseServer, WarehouseDatabase, [CreateNavigationProperties=false]),
			    Data = Source{[Schema="public", Item="vw_metrics"]}[Data]
			in
			    Data
