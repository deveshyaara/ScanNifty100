# ScanNifty100 — Production Environment Template
# Copy this file to .env and fill in ALL values before deploying.
# Never commit the .env file — it is gitignored.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database ─────────────────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=scannifty100
DB_USER=scannifty100
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=localhost
DB_PORT=5433

# ── Security (production only) ───────────────────────────────────────────────
# Comma-separated list of origins allowed to send CSRF-protected POST requests.
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Comma-separated origins allowed by CORS (for the DRF API).
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Paths ────────────────────────────────────────────────────────────────────
N100_SOURCE_DIR=data/source
N100_RAW_DIR=data/raw
N100_CLEAN_DIR=data/clean
N100_STAGING_DIR=data/staging

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/scannifty100.log

# ── Monitoring ───────────────────────────────────────────────────────────────
# Get your DSN from https://sentry.io — leave blank to disable.
SENTRY_DSN=

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Environment marker ───────────────────────────────────────────────────────
ENVIRONMENT=production
